# クラウド公開時の設定例（Fly.io の secrets に登録）

# 必須: 店舗スタッフに共有するログインパスワード
APP_PASSWORD=haizi814

# 必須: セッション用（ランダムな長い文字列）
SECRET_KEY=random-long-string

# PostgreSQL（Neon の Connection string）
DATABASE_URL=postgresql://...

# Fly.io が自動設定（手動不要）
# FLY_APP_NAME=shabon-inventory
PORT=8080
HOST=0.0.0.0
OPEN_BROWSER=false
